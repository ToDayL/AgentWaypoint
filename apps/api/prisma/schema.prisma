generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String           @id @default(cuid())
  email                String           @unique
  displayName          String?
  isActive             Boolean          @default(true)
  role                 String           @default("user")
  authPolicy           String           @default("password_or_webauthn")
  passwordHash         String?
  lastLoginAt          DateTime?
  turnSteerEnabled     Boolean          @default(false)
  defaultWorkspaceRoot String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  projects             Project[]
  authSessions         AuthSession[]
  botIntegrations      BotIntegration[]
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  sessionTokenHash String    @unique
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  revokedAt        DateTime?
  ip               String?
  userAgent        String?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, revokedAt])
}

model Project {
  id            String        @id @default(cuid())
  ownerUserId   String
  name          String
  repoPath      String?
  backend       String        @default("codex")
  backendConfig Json?
  createdAt     DateTime      @default(now())
  sessions      Session[]
  botMessages   BotMessage[]
  channelFiles  ChannelFile[]
  owner         User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
}

model Session {
  id              String        @id @default(cuid())
  projectId       String
  title           String
  status          String
  backendThreadId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  messages        Message[]
  turns           Turn[]
  botMessages     BotMessage[]
  channelFiles    ChannelFile[]
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Message {
  id         String   @id @default(cuid())
  sessionId  String
  role       String
  content    String
  tokenCount Int?
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Turn {
  id                     String         @id @default(cuid())
  sessionId              String
  userMessageId          String?
  assistantMessageId     String?
  triggerIdentifier      String         @default("web")
  triggerProvider        String?        @default("web")
  triggerIntegrationId   String?
  triggerMessageId       String?
  status                 String
  backend                String?
  requestedBackendConfig Json?
  effectiveBackendConfig Json?
  effectiveRuntimeConfig Json?
  failureCode            String?
  failureMessage         String?
  contextRemainingRatio  Decimal?       @db.Decimal(5, 4)
  contextRemainingTokens Int?
  contextWindowTokens    Int?
  contextUpdatedAt       DateTime?
  startedAt              DateTime?
  endedAt                DateTime?
  createdAt              DateTime       @default(now())
  session                Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  events                 Event[]
  approvals              TurnApproval[]

  @@index([sessionId])
}

model TurnApproval {
  id         String    @id @default(cuid())
  turnId     String
  requestId  String
  kind       String
  status     String
  payload    Json
  decision   String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  turn       Turn      @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@unique([turnId, requestId])
  @@index([turnId, status, createdAt])
}

model Event {
  id        String   @id @default(cuid())
  turnId    String
  seq       Int
  type      String
  payload   Json
  createdAt DateTime @default(now())
  turn      Turn     @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([turnId, seq])
}

model BotIntegration {
  id                   String    @id @default(cuid())
  ownerUserId          String
  provider             String
  name                 String
  status               String
  credentialsEncrypted Json?
  pluginConfig         Json?
  lastSyncAt           DateTime?
  lastErrorAt          DateTime?
  lastErrorMessage     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  owner                User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, status, updatedAt])
  @@index([provider, status, updatedAt])
}

model BotMessage {
  id                String    @id @default(cuid())
  projectId         String
  sessionId         String
  kind              String
  payloadRaw        Json
  status            String
  attemptCount      Int       @default(0)
  nextAttemptAt     DateTime?
  claimedBy         String?
  claimedAt         DateTime?
  leaseExpireAt     DateTime?
  providerMessageId String?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime  @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session           Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([projectId, sessionId, createdAt])
  @@index([status, nextAttemptAt, createdAt])
  @@index([status, leaseExpireAt, createdAt])
}

model ChannelFile {
  id              String   @id @default(cuid())
  projectId       String
  sessionId       String
  storageProvider String
  storageKey      String
  fileName        String
  mimeType        String
  sizeBytes       Int
  checksumSha256  String?
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([projectId, sessionId, createdAt])
  @@index([storageProvider, storageKey])
}

model BotAuthSession {
  id               String    @id @default(cuid())
  botIntegrationId String?
  provider         String
  status           String
  challengeType    String?
  challengePayload Json?
  resultPayload    Json?
  expiresAt        DateTime?
  lastPolledAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([botIntegrationId, status, updatedAt])
  @@index([provider, status, createdAt])
}
