API_PORT=4000
LISTEN_IP=0.0.0.0
PORT=4000
AGENTWAYPOINT_HOME=/tmp/agentwaypoint-api-dev
DATABASE_URL=file:/tmp/agentwaypoint-api-dev/agentwaypoint.db
DEFAULT_WORKSPACE_ROOT=/tmp/agentwaypoint-api-dev/workspaces
RUNNER_MODE=embedded
RUNNER_SUPPORTED_BACKENDS=codex,claude,mock
RUNNER_BASE_URL=http://127.0.0.1:4700
JWT_SECRET=change-me-in-production
RUNNER_HTTP_TIMEOUT_MS=5000
RUNNER_AUTH_TOKEN=
RUNNER_CODEX_BIN=codex
RUNNER_CODEX_CWD=
RUNNER_CODEX_MODEL=
RUNNER_CODEX_APPROVAL_POLICY=on-request
RUNNER_CODEX_SANDBOX=
RUNNER_ALLOWED_REPO_ROOTS=
AUTH_SESSION_COOKIE_NAME=aw_session
AUTH_SESSION_TTL_HOURS=168
AUTH_DEV_EMAIL_HEADER=1
