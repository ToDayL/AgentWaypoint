# Optional manual development environment.
# The agent-waypoint CLI normally writes these values into config.json under
# AGENTWAYPOINT_HOME. Keep local/test homes separate from ~/.agentwaypoint.

NODE_ENV=development
AGENTWAYPOINT_HOME=/tmp/agentwaypoint-dev

# API/Web
API_PORT=4000
PORT=4000
WEB_PORT=3000
LISTEN_IP=0.0.0.0
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# SQLite
DATABASE_URL=file:/tmp/agentwaypoint-dev/agentwaypoint.db

# Auth
# JWT_SECRET is still written into generated config.json for compatibility with
# older config shape, but current browser auth uses opaque AuthSession cookies.
JWT_SECRET=change-me-in-production
AUTH_SESSION_COOKIE_NAME=aw_session
AUTH_SESSION_TTL_HOURS=168
AUTH_DEV_EMAIL_HEADER=1

# Runner
RUNNER_MODE=embedded
RUNNER_SUPPORTED_BACKENDS=codex,claude,mock
RUNNER_BASE_URL=http://127.0.0.1:4700
RUNNER_HTTP_TIMEOUT_MS=5000
RUNNER_AUTH_TOKEN=

# Embedded Codex backend
RUNNER_CODEX_BIN=codex
RUNNER_CODEX_CWD=
RUNNER_CODEX_MODEL=
RUNNER_CODEX_APPROVAL_POLICY=on-request
RUNNER_CODEX_SANDBOX=
RUNNER_ALLOWED_REPO_ROOTS=
RUNNER_EVENT_RETENTION_MS=300000
RUNNER_EVENT_BUFFER_LIMIT=1000
DEFAULT_WORKSPACE_ROOT=/tmp/agentwaypoint-dev/workspaces

# Optional proxy
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
