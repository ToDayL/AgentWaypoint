# Optional manual development environment.
# The agent-waypoint CLI normally writes these values into config.json under
# AGENTWAYPOINT_HOME. Keep local/test homes separate from ~/.agentwaypoint.

NODE_ENV=development
AGENTWAYPOINT_HOME=/tmp/agentwaypoint-dev

# API/Web
API_PORT=4000
PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
WEB_API_BASE_URL=http://localhost:4000

# SQLite
DATABASE_URL=file:/tmp/agentwaypoint-dev/agentwaypoint.db

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
AUTH_SESSION_COOKIE_NAME=aw_session
AUTH_SESSION_TTL_HOURS=168
AUTH_DEV_EMAIL_HEADER=1

# Embedded runner
RUNNER_MODE=embedded
RUNNER_HTTP_TIMEOUT_MS=5000
RUNNER_AUTH_TOKEN=
RUNNER_CODEX_BIN=codex
RUNNER_CODEX_CWD=
RUNNER_CODEX_MODEL=
RUNNER_CODEX_APPROVAL_POLICY=on-request
RUNNER_CODEX_SANDBOX=
RUNNER_ALLOWED_REPO_ROOTS=
DEFAULT_WORKSPACE_ROOT=/tmp/agentwaypoint-dev/workspaces

# Optional proxy
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
