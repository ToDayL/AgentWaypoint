{
  "name": "agentwaypoint",
  "version": "0.1.0",
  "private": true,
  "description": "AgentWaypoint monorepo workspace",
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "AGENTWAYPOINT_HOME=$PWD/.agentwaypoint-dev pnpm --filter @agentwaypoint/api dev",
    "dev:up": "./scripts/dev-up.sh",
    "dev:down": "./scripts/dev-down.sh",
    "dev:status": "./scripts/dev-status.sh",
    "prod:up": "./scripts/prod-up.sh",
    "prod:down": "./scripts/prod-down.sh",
    "prod:status": "./scripts/prod-status.sh",
    "test:api:e2e": "./scripts/test-api-e2e.sh",
    "build": "pnpm --filter @agentwaypoint/api prisma:generate && pnpm -r --if-present build",
    "start": "./agent-waypoint start",
    "stop": "./agent-waypoint stop",
    "restart": "./agent-waypoint restart",
    "status": "./agent-waypoint status",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "pnpm -r --if-present format"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
