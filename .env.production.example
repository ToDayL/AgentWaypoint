# Optional production environment overrides for shell/systemd usage.
# The first-run CLI stores durable config in $AGENTWAYPOINT_HOME/config.json.

NODE_ENV=production
AGENTWAYPOINT_HOME=/srv/agentwaypoint

# API/Web
API_PORT=4000
PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
WEB_API_BASE_URL=http://localhost:4000

# SQLite
DATABASE_URL=file:/srv/agentwaypoint/agentwaypoint.db

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
AUTH_SESSION_COOKIE_NAME=aw_session
AUTH_SESSION_TTL_HOURS=168
AUTH_DEV_EMAIL_HEADER=0

# Embedded runner
RUNNER_MODE=embedded
RUNNER_HTTP_TIMEOUT_MS=5000
RUNNER_AUTH_TOKEN=
RUNNER_CODEX_BIN=codex
RUNNER_CODEX_CWD=
RUNNER_CODEX_MODEL=
RUNNER_CODEX_APPROVAL_POLICY=on-request
RUNNER_CODEX_SANDBOX=
RUNNER_ALLOWED_REPO_ROOTS=
DEFAULT_WORKSPACE_ROOT=/srv/agentwaypoint/workspaces

# Optional proxy
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
